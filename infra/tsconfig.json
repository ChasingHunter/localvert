{
  "compilerOptions": {
    "target": "ES2023",
    // No "DOM" here, deliberately: `worker-configuration.d.ts` (generated by
    // `wrangler types`) declares its own ambient `Request`/`Response`/
    // `Headers`/`Cache`/... globals shaped for the Workers runtime (e.g.
    // `Request.cf`). Adding "DOM" would give two conflicting global
    // declarations of the same names — see docs/ROADMAP.md's 0.4 note on
    // the same DOM-vs-WebWorker lib clash for `src/lib/workers/`.
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Ambient globals come solely from worker-configuration.d.ts (included
    // below); this keeps @types/node's own Request/Response/Headers/...
    // declarations (visible via the root node_modules) out of this
    // program, since they'd otherwise collide with the runtime's.
    "types": []
  },
  "include": ["worker/**/*.ts", "worker-configuration.d.ts"]
}
