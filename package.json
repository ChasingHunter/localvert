{
  "name": "localvert",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first file converter. Images, video, audio, PDF, documents and compression, converted entirely in your browser. Files never leave your device.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sync-engines && next build && node scripts/flatten-rsc.ts && node scripts/csp-inline-hashes.ts && node scripts/build-sw.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p infra --noEmit && tsc -p tsconfig.browser-tests.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:browser": "pnpm sync-engines && vitest run --config vitest.browser.config.ts",
    "e2e": "playwright test",
    "gen": "node scripts/gen-registry.ts",
    "postinstall": "pnpm gen",
    "sync-engines": "node scripts/sync-engines.ts && pnpm gen",
    "upload-r2": "node scripts/upload-r2.ts",
    "preview": "pnpm build && wrangler dev --config infra/wrangler.jsonc --port 8788",
    "check-sizes": "node scripts/check-sizes.ts",
    "check": "pnpm gen && pnpm typecheck && pnpm lint && pnpm test",
    "check-engine-eval": "node scripts/check-engine-eval.ts",
    "verify": "pnpm check && pnpm build && pnpm check-sizes && pnpm check-engine-eval"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.1": "^7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@bentopdf/libreoffice-wasm": "2.3.1",
    "@cantoo/pdf-lib": "^2.11.1",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-annotation": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-export": "2.15.1",
    "@embedpdf/plugin-history": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-thumbnail": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@ffmpeg/core": "0.12.10",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@image-tracer-ts/core": "^1.0.2",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@mediabunny/flac-encoder": "1.60.0",
    "@mediabunny/mp3-encoder": "1.60.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@webtoon/psd": "^0.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "fflate": "~0.8.3",
    "gifenc": "1.0.3",
    "heic-to": "^1.5.2",
    "image-q": "4.0.0",
    "libraw-wasm": "^1.6.0",
    "lucide-react": "^1.48.0",
    "mediabunny": "1.60.0",
    "next": "^16.3.6",
    "papaparse": "5.7.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "9.3.10",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2",
    "utif2": "^4.1.0",
    "write-excel-file": "4.1.1",
    "yaml": "2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "playwright": "^1.63.0",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.138.0"
  }
}
