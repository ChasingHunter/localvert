{
  "id": "pdfjs",
  "license": "Apache-2.0",
  "location": "static",
  "needsIsolation": false,
  "heavy": true,
  "package": "pdfjs-dist",
  "files": [
    {
      "from": "build/pdf.mjs",
      "to": "pdf.mjs"
    },
    {
      "from": "build/pdf.worker.mjs",
      "to": "pdf.worker.mjs"
    },
    {
      "from": "cmaps/",
      "to": "cmaps/"
    },
    {
      "from": "standard_fonts/",
      "to": "standard_fonts/"
    }
  ]
}
