# Security headers for every response. See docs/adr/0001-client-side-only.md
# (the no-upload guarantee) and docs/adr/0006-two-layer-csp.md (why the CSP
# below is deliberately tolerant of inline scripts, and where the strict
# layer that closes that gap actually lives).
#
# connect-src is the whole privacy guarantee made mechanical: 'self blob:'
# lets the app talk to its own worker/object-URL traffic and nothing else.
# Never widen it — that is the one line that makes "files never leave your
# browser" a checkable fact instead of a promise.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob:; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/engines/*
  Cache-Control: public, max-age=31536000, immutable
