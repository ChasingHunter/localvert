# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
.vitest/

# Engine assets (synced from node_modules by `pnpm sync-engines`, never committed)
public/engines/
# r2 engine staging area (uploaded by `pnpm upload-r2`, never committed)
.engines-r2/

# Build output, regenerated by `pnpm gen` (postinstall, and `pnpm check`) —
# versions/sizes are derived from installed packages, so this would only
# ever diff on a dependency bump. src/lib/engines/{ids,loaders}.ts and
# src/tools/{index,loaders}.ts stay committed — a version bump never touches
# them, only manifest.ts.
src/lib/engines/manifest.ts

# Environment & secrets
.env
.env.*
!.env.example

# Cloudflare
.wrangler/
.dev.vars

# Claude Code — private, machine-local context (never public)
.claude/settings.local.json
.claude/local.md
CLAUDE.local.md
.claude/plans/
.claude/worktrees/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Next.js — regenerated on every build, no project-specific content
next-env.d.ts
