.env
.env.*
!.env.example

# Cloudflare
.wrangler/
.dev.vars

# Claude Code — private, machine-local context (never public)
.claude/settings.local.json
.claude/local.md
CLAUDE.local.md
.claude/plans/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Next.js — regenerated on every build, no project-specific content
next-env.d.ts
